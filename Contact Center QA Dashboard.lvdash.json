{
  "datasets": [
    {
      "name": "ds_daily_trend",
      "displayName": "Daily QA Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('DAY', s.transcribed_at) as eval_date,\n",
        "  COUNT(*) as calls_evaluated,\n",
        "  ROUND(AVG(g.overall_qa_score), 2) as avg_score\n",
        "FROM\n",
        "  gold_enriched_calls g\n",
        "    JOIN silver_transcriptions s\n",
        "      ON g.call_id = s.call_id\n",
        "GROUP BY\n",
        "  DATE_TRUNC('DAY', s.transcribed_at)\n",
        "ORDER BY\n",
        "  eval_date"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    },
    {
      "name": "ds_sentiment_by_category",
      "displayName": "Sentiment by Call Category",
      "queryLines": [
        "SELECT\n",
        "  call_category,\n",
        "  sentiment,\n",
        "  COUNT(*) as call_count,\n",
        "  ROUND(AVG(overall_qa_score), 2) as avg_qa_score\n",
        "FROM\n",
        "  gold_enriched_calls\n",
        "GROUP BY\n",
        "  call_category,\n",
        "  sentiment\n",
        "ORDER BY\n",
        "  call_category,\n",
        "  sentiment"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    },
    {
      "name": "ds_flagged",
      "displayName": "Flagged Calls",
      "queryLines": [
        "SELECT\n",
        "  call_id,\n",
        "  agent_id,\n",
        "  queue_type,\n",
        "  call_category,\n",
        "  overall_qa_score,\n",
        "  compliance_flags,\n",
        "  coaching_notes\n",
        "FROM\n",
        "  gold_enriched_calls\n",
        "WHERE\n",
        "  requires_human_review = true\n",
        "ORDER BY\n",
        "  overall_qa_score ASC\n",
        "LIMIT 100"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    },
    {
      "name": "ds_agent_perf",
      "displayName": "Agent Performance",
      "queryLines": [
        "SELECT\n",
        "  agent_id,\n",
        "  COUNT(*) as calls_evaluated,\n",
        "  ROUND(AVG(overall_qa_score), 2) as avg_score,\n",
        "  ROUND(AVG(greeting_score), 2) as avg_greeting,\n",
        "  ROUND(AVG(empathy_score), 2) as avg_empathy,\n",
        "  ROUND(AVG(accuracy_score), 2) as avg_accuracy,\n",
        "  ROUND(AVG(escalation_score), 2) as avg_escalation,\n",
        "  ROUND(AVG(compliance_score), 2) as avg_compliance,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN requires_human_review THEN 1\n",
        "    END\n",
        "  ) as flagged_calls\n",
        "FROM\n",
        "  gold_enriched_calls\n",
        "GROUP BY\n",
        "  agent_id\n",
        "ORDER BY\n",
        "  avg_score DESC"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    },
    {
      "name": "ds_queue_perf",
      "displayName": "Queue Performance",
      "queryLines": [
        "SELECT\n",
        "  queue_type,\n",
        "  COUNT(*) as total_calls,\n",
        "  ROUND(AVG(overall_qa_score), 2) as avg_score,\n",
        "  ROUND(AVG(greeting_score), 2) as avg_greeting,\n",
        "  ROUND(AVG(empathy_score), 2) as avg_empathy,\n",
        "  ROUND(AVG(accuracy_score), 2) as avg_accuracy,\n",
        "  ROUND(AVG(escalation_score), 2) as avg_escalation,\n",
        "  ROUND(AVG(compliance_score), 2) as avg_compliance\n",
        "FROM\n",
        "  gold_enriched_calls\n",
        "GROUP BY\n",
        "  queue_type\n",
        "ORDER BY\n",
        "  avg_score DESC"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    },
    {
      "name": "ds_sentiment",
      "displayName": "Sentiment Distribution",
      "queryLines": [
        "SELECT\n",
        "  sentiment,\n",
        "  COUNT(*) as call_count\n",
        "FROM\n",
        "  gold_enriched_calls\n",
        "GROUP BY\n",
        "  sentiment"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    },
    {
      "name": "ds_kpis",
      "displayName": "KPI Summary",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) as total_calls,\n",
        "  ROUND(AVG(overall_qa_score), 2) as avg_qa_score,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN requires_human_review THEN 1\n",
        "    END\n",
        "  ) as flagged_calls,\n",
        "  ROUND(\n",
        "    COUNT(\n",
        "      CASE\n",
        "        WHEN overall_qa_score >= 4 THEN 1\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) as pct_excellent\n",
        "FROM\n",
        "  gold_enriched_calls"
      ],
      "catalog": "yyang",
      "schema": "contact_center_qa"
    }
  ],
